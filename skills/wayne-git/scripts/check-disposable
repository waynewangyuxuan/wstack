#!/usr/bin/env bash
# Fail if files added by Disposable commits on this branch still exist, or a Disposable commit changed existing files.
set -euo pipefail

base=${1:-}
if [ -z "$base" ]; then
  for ref in origin/HEAD origin/main origin/master main master; do
    if git rev-parse -q --verify "$ref^{commit}" >/dev/null; then
      base=$(git merge-base HEAD "$ref")
      break
    fi
  done
fi
if [ -z "$base" ]; then
  echo "check-disposable: no base branch found; pass one, e.g. check-disposable origin/develop" >&2
  exit 2
fi

problems=0
count=0
while read -r sha; do
  [ -n "$sha" ] || continue
  count=$((count + 1))
  label="${sha:0:7} \"$(git log -1 --format=%s "$sha")\""
  changed=$(git show --format= --name-status --no-renames "$sha" | awk -F'\t' '$1 != "A" {print "  " $1 " " $2}')
  if [ -n "$changed" ]; then
    echo "Disposable commit $label changes existing files:"
    echo "$changed"
    problems=1
  fi
  while read -r file; do
    [ -n "$file" ] || continue
    if git cat-file -e "HEAD:$file" 2>/dev/null; then
      echo "Still present: $file (added by Disposable commit $label)"
      problems=1
    fi
  done < <(git show --format= --name-only --diff-filter=A --no-renames "$sha")
done < <(git log --format=%H --grep='^Disposable:' "$base..HEAD")

if [ "$problems" -ne 0 ]; then
  echo "check-disposable: not clean. Delete the files above in a commit, and keep Disposable commits to new files only."
  exit 1
fi
echo "check-disposable: clean ($count Disposable commit(s) since ${base:0:7})"
